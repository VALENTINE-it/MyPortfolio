# Portfolio Backend Environment Configuration Template

# Server Port (default: 8080)
PORT=8080

# Application Environment (development, staging, production)
APP_ENV=development

# SQLite Database File Location (stored safely outside public folders)
DATABASE_PATH=./data/portfolio.db

# Comma-separated allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Client IP & Proxy Security (set to true ONLY if deployed behind a trusted reverse proxy)
TRUST_PROXY=false

# General API Rate Limiting (default: 100 requests per 1 minute per client)
RATE_LIMIT_GENERAL_REQ=100
RATE_LIMIT_GENERAL_WINDOW=1m

# Sensitive Contact Endpoint Rate Limiting (default: 5 submissions per 10 minutes per client)
RATE_LIMIT_CONTACT_REQ=5
RATE_LIMIT_CONTACT_WINDOW=10m

# HTTP Server Timeouts & Limits
READ_TIMEOUT=10s
READ_HEADER_TIMEOUT=5s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
MAX_HEADER_BYTES=1048576
MAX_REQUEST_BODY_BYTES=65536
